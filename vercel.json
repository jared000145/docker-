{
  "framework": "vite",
  "buildCommand": "npm run build:hosted",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/version.json", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/mobile/updates-:channel.json", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/mobile/bundles/:bundle", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/downloads/:file.apk", "headers": [{ "key": "Content-Type", "value": "application/vnd.android.package-archive" }, { "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}
